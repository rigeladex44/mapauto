# Do not put a real merchant PIN or cookies in this file or in Git.
MAP_ACCESS_KEY=replace-with-at-least-24-random-characters
MAP_HEADLESS=false
MAP_MAX_SESSIONS=2
# For separate Vercel frontend only, exact HTTPS origin(s), comma separated.
MAP_ALLOWED_ORIGINS=
