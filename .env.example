# Copy to .env; never commit real values. Local development defaults.
APP_ENV=development
DATABASE_URL=sqlite:///./mapauto.db
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DEMO_MODE=false
SESSION_HOURS=8
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Production: APP_ENV=production, PostgreSQL URL, COOKIE_SECURE=true,
# explicit ALLOWED_HOSTS, HTTPS reverse proxy, DEMO_MODE=false.
# Compose only (choose a strong value locally; no default password):
POSTGRES_PASSWORD=
