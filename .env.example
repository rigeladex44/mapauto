# VPS defaults. Run scripts/generate-keys.py to create .env safely; never commit it.
APP_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com
APP_ENV=production
ALLOWED_HOSTS=app.example.com,localhost,127.0.0.1
COOKIE_SECURE=true
DEMO_MODE=false
DATABASE_URL=
POSTGRES_PASSWORD=
REDIS_URL=
REDIS_PASSWORD=
DATA_ENCRYPTION_KEY=
NIK_HASH_KEY=
WORKER_CONCURRENCY=1
MAX_BROWSER_CONTEXTS=1
WORKER_MEMORY=1536m
WORKER_CPUS=1.0
WORKER_LEASE_SECONDS=90
VERIFICATION_SECONDS=180
SESSION_HOURS=8
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secret values belong only in restricted server environment/secret manager.
# Never reuse credential/session data from the old repository history.
