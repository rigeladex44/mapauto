# syntax=docker/dockerfile:1
FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.lock /tmp/requirements.lock
RUN --mount=type=secret,id=ca_bundle \
    if [ -s /run/secrets/ca_bundle ]; then export PIP_CERT=/run/secrets/ca_bundle; fi; \
    pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock
COPY --chown=10001:10001 backend/app ./backend/app
COPY --chown=10001:10001 backend/migrations ./backend/migrations
COPY --chown=10001:10001 backend/alembic.ini ./backend/alembic.ini
RUN groupadd -g 10001 app && useradd -u 10001 -g app -M app
USER 10001:10001
CMD ["uvicorn","backend.app.main:app","--host","0.0.0.0","--port","8000","--no-access-log","--proxy-headers","--forwarded-allow-ips=172.29.0.10"]
