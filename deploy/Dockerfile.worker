# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 BROWSER_EXECUTABLE=/usr/bin/chromium
WORKDIR /app
# Debian package signatures remain enforced. The browser binary is image-local.
RUN --mount=type=secret,id=ca_bundle \
    if [ -s /run/secrets/ca_bundle ]; then export SSL_CERT_FILE=/run/secrets/ca_bundle; fi; \
    apt-get update && apt-get install -y --no-install-recommends chromium fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.lock backend/worker-requirements.lock /tmp/
RUN --mount=type=secret,id=ca_bundle \
    if [ -s /run/secrets/ca_bundle ]; then export PIP_CERT=/run/secrets/ca_bundle; fi; \
    pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock -r /tmp/worker-requirements.lock
COPY --chown=10001:10001 backend/app ./backend/app
RUN groupadd -g 10001 mapauto && useradd -u 10001 -g mapauto -m mapauto
USER 10001:10001
CMD ["python","-m","backend.app.browser_worker"]
